{
  "table_id": "de_demonstratives_ref",
  "title": {
    "en": "Demonstratives & directions",
    "ko": "지시대명사·방향",
    "ja": "指示詞・方向",
    "zh": "指示词与方向",
    "fr": "Démonstratifs & directions",
    "es": "Demostrativos y direcciones",
    "de": "Demonstrativa & Richtungen",
    "ru": "Указательные и направления",
    "it": "Dimostrativi e direzioni"
  },
  "note": {
    "en": "Everyday speech leans on dieser + hier/da/dort. jener is clearer for “farther” but more formal. Not a Spanish-style three-way este/ese/aquel.",
    "ko": "일상은 dieser + hier/da/dort. jener는 「멀리」에 분명하지만 더 격식. 스페인어 este/ese/aquel 삼원과는 다름.",
    "ja": "日常は dieser ＋ hier／da／dort。jener は遠いが硬い。スペイン語の三区分ではない。",
    "zh": "日常多用 dieser + hier／da／dort。jener 表“较远”但偏正式。不是西语三向。",
    "fr": "À l’oral : dieser + hier/da/dort. jener plus formel. ≠ système espagnol à trois.",
    "es": "Oral: dieser + hier/da/dort. jener más formal. ≠ este/ese/aquel.",
    "de": "Alltag: dieser + hier/da/dort. jener förmlicher. ≠ spanisches Dreiersystem.",
    "ru": "В речи: dieser + hier/da/dort. jener формальнее. ≠ испанская тройка.",
    "it": "All’orale: dieser + hier/da/dort. jener più formale. ≠ sistema spagnolo a tre."
  },
  "rules": {
    "en": [
      "dieser/diese/dieses decline strongly (like ein + der endings). Agree with the noun.",
      "das as a standalone pronoun ≈ “this/that” (Das ist gut.).",
      "hier ≈ near me; da ≈ pointing/known; dort ≈ farther over there.",
      "der/die/das can also be demonstrative (“that one”) — advanced; not in this quiz."
    ],
    "ko": [
      "dieser/diese/dieses는 강변화(ein+정관사 어미). 명사에 일치.",
      "단독 das ≈ 「이것/그것」(Das ist gut.).",
      "hier ≈ 화자 쪽; da ≈ 가리키며/알려진 곳; dort ≈ 더 멀리.",
      "der/die/das도 지시로 쓰임(고급) — 이 퀴즈에는 미포함."
    ],
    "ja": [
      "dieser などは強変化。名詞に一致。",
      "単独の das ≈「これ／それ」。",
      "hier＝ここ、da＝指し示し、dort＝もっと向こう。",
      "定冠詞の指示用法は発展（クイズ外）。"
    ],
    "zh": [
      "dieser 等强变化，随后面名词一致。",
      "单独 das≈“这／那”。",
      "hier≈靠近我；da≈指着／已知；dort≈更远。",
      "定冠词作指示属进阶（不进测验）。"
    ],
    "fr": [
      "dieser… se décline fortement.",
      "das seul ≈ « ceci/cela ».",
      "hier / da / dort.",
      "der/die/das démonstratif = avancé."
    ],
    "es": [
      "dieser… se declina fuertemente.",
      "das solo ≈ “esto/eso”.",
      "hier / da / dort.",
      "der/die/das demostrativo = avanzado."
    ],
    "de": [
      "dieser… starke Deklination.",
      "das allein ≈ „dies/das“.",
      "hier / da / dort.",
      "der/die/das demonstrativ = fortgeschritten."
    ],
    "ru": [
      "dieser… сильное склонение.",
      "das отдельно ≈ «это».",
      "hier / da / dort.",
      "der/die/das как указательное — продвинуто."
    ],
    "it": [
      "dieser… declinazione forte.",
      "das da solo ≈ «questo/ciò».",
      "hier / da / dort.",
      "der/die/das dimostrativo = avanzato."
    ]
  },
