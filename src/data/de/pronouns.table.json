  "note": {
    "en": "German declines pronouns by case. Quiz = Nominativ. Learn Akkusativ/Dativ from the chart (not separate quiz cards yet).",
    "ko": "독일어는 격에 따라 형태가 바뀝니다. 퀴즈는 주격만. 목적·여격은 표로 학습(별도 퀴즈 카드 없음).",
    "ja": "ドイツ語は格で形が変わる。クイズは主格のみ。対格・与格は表で。",
    "zh": "德语代词随格变化。测验仅主格。宾格／与格见下表。",
    "fr": "Déclinaison par cas. Quiz = nominatif. Accusatif/datif = tableau.",
    "es": "Declinación por caso. Quiz = nominativo. Acusativo/dativo = tabla.",
    "de": "Quiz = Nominativ. Akkusativ/Dativ = Tabelle (noch kein Extra-Quiz).",
    "ru": "Склонение по падежам. Квиз = именительный. Вин./дат. — таблица.",
    "it": "Declinazione per caso. Quiz = nominativo. Acc./dat. = tabella."
  },
  "rules": {
    "en": [
      "du = informal you; Sie (capital) = formal you (sg/pl) with 3rd-person plural verbs: Sie sind.",
      "sie = she OR they — context (and capitalization of Sie) decides.",
      "es = neuter “it” and impersonal subject (Es regnet. / Es gibt…).",
      "Akkusativ often after verbs like sehen, haben; Dativ after helfen, geben, mit, zu…"
    ],
    "ko": [
      "du = 반말; Sie(대문자) = 존댓말(단·복), 동사는 3인칭 복수: Sie sind.",
      "sie = 그녀 또는 그들 — 문맥(·존댓말 Sie 대문자)으로 구분.",
      "es = 중성 「그것」·비인칭 주어(Es regnet / Es gibt).",
      "목적격은 sehen, haben 등; 여격은 helfen, geben, mit, zu 등 뒤에 자주."
    ],
    "ja": [
      "du＝くだけた、Sie（大文字）＝丁寧（単複）、動詞は三人称複数。",
      "sie＝彼女または彼ら。文脈と大文字の Sie で区別。",
      "es＝中性の「それ」・非人称主語。",
      "対格は sehen, haben など、与格は helfen, geben, mit, zu などのあと。"
    ],
    "zh": [
      "du＝随便；Sie（大写）＝正式（单复数），动词用第三人称复数。",
      "sie＝她或他们——靠语境与大写 Sie。",
      "es＝中性“它”／虚主语。",
      "宾格常跟 sehen、haben；与格常跟 helfen、geben、mit、zu。"
    ],
    "fr": [
      "du = familier ; Sie (majuscule) = formel ; verbe à la 3e pluriel.",
      "sie = elle ou ils/elles — contexte / Sie majuscule.",
      "es = neutre et sujet impersonnel.",
      "Accusatif après sehen, haben… ; datif après helfen, geben, mit, zu…"
    ],
    "es": [
      "du = informal; Sie (mayúscula) = formal; verbo en 3.ª plural.",
      "sie = ella o ellos — contexto / Sie mayúscula.",
      "es = neutro y sujeto impersonal.",
      "Acusativo tras sehen, haben…; dativo tras helfen, geben, mit, zu…"
    ],
    "de": [
      "du = informell; Sie (groß) = höflich; Verb in 3. Person Plural.",
      "sie = sie (f.) oder sie (Pl.) — Kontext / Sie groß.",
      "es = Neutrum und Platzhalter.",
      "Akkusativ oft nach sehen, haben…; Dativ nach helfen, geben, mit, zu…"
    ],
    "ru": [
      "du = неформ.; Sie (заглавная) = вежл.; глагол во мн. 3-го лица.",
      "sie = она или они — контекст / Sie с заглавной.",
      "es = средний род и безличное подлежащее.",
      "Вин. часто после sehen, haben…; дат. после helfen, geben, mit, zu…"
    ],
    "it": [
      "du = informale; Sie (maiuscola) = formale; verbo alla 3ª plurale.",
      "sie = lei o loro — contesto / Sie maiuscola.",
      "es = neutro e soggetto formale.",
      "Accusativo dopo sehen, haben…; dativo dopo helfen, geben, mit, zu…"
    ]
  },
