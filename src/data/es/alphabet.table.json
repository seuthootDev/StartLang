  "table_id": "es_alphabet_ref",
  "title": {
    "en": "Spanish alphabet",
    "ko": "스페인어 알파벳",
    "ja": "スペイン語アルファベット",
    "zh": "西班牙语字母",
    "fr": "Alphabet espagnol",
    "es": "Alfabeto español",
    "de": "Spanisches Alphabet",
    "ru": "Испанский алфавит",
    "it": "Spanish alphabet"
  },
  "note": {
    "en": "A–Z plus Ñ. Type the Spanish letter name (slash answers accept either side). Accents mark stress or ü in güe/güi.",
    "ko": "A–Z와 Ñ. 스페인어 글자 이름을 입력하세요 (/ 는 양쪽 모두 정답). 악센트는 강세·güe/güi의 ü.",
    "ja": "A–Zと Ñ。スペイン語の文字名を入力（/ はどちらでも可）。アクセントは強勢や güe/güi の ü。",
    "zh": "A–Z 与 Ñ。输入西班牙语字母名（斜杠两侧均可）。重音标重音或 güe/güi 中的 ü。",
    "fr": "A–Z et Ñ. Tapez le nom espagnol (/ = les deux). Accents = stress ou ü (güe/güi).",
    "es": "A–Z y Ñ. Escribe el nombre (/ acepta ambos). Tildes = tilde diacrítica o ü.",
    "de": "A–Z plus Ñ. Spanischen Namen tippen (/ = beide). Akzente = Betonung oder ü.",
    "ru": "A–Z и Ñ. Введите испанское имя (/ — любой вариант). Ударения или ü.",
    "it": "A–Z plus Ñ. Type the Spanish letter name (slash answers accept either side). Accents mark stress or ü in güe/güi."
  },
